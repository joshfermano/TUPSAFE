# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Config files
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.eslintrc* text eol=lf
.prettierrc* text eol=lf
tsconfig.json text eol=lf
package.json text eol=lf
package-lock.json text eol=lf
turbo.json text eol=lf

# Documentation
*.txt text eol=lf
LICENSE text eol=lf
README* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary

# Exclude build artifacts from git diff
*.d.ts linguist-generated=true
*.js.map linguist-generated=true
*.d.ts.map linguist-generated=true

# Package lock files - use merge=binary to avoid conflicts
package-lock.json merge=binary
pnpm-lock.yaml merge=binary
yarn.lock merge=binary

# TypeScript build info files should not be merged
*.tsbuildinfo binary
