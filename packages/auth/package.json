{
  "name": "@tupsafe/auth",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "default": "./dist/edge.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist && rimraf --glob \"*.tsbuildinfo\"",
    "build": "tsc --build",
    "postbuild": "node -e \"const fs = require('fs'); if (!fs.existsSync('dist/middleware.js')) { console.error('❌ ERROR: middleware.js not generated!'); process.exit(1); }\"",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tupsafe/database": "workspace:*",
    "@tupsafe/types": "workspace:*",
    "@upstash/ratelimit": "^2.0.4",
    "@upstash/redis": "^1.34.3",
    "lucide-react": "^0.544.0",
    "react-hook-form": "^7.63.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": "19.1.0"
  }
}
