# Use hoisted node_modules structure for Next.js standalone output compatibility.
# Next.js standalone output traces file dependencies via the filesystem, and
# pnpm's default symlinked structure causes missing modules in the standalone bundle.
node-linker=hoisted

# Hoist all packages to root node_modules. Required because:
# 1. Next.js standalone output needs flat node_modules for file tracing
# 2. @react-pdf/renderer has deep peer dependency chains
# 3. docker-compose.yml references /app/node_modules/.bin/next directly
shamefully-hoist=true

# Automatically install peer dependencies (pnpm is strict about peers by default)
auto-install-peers=true

# Deduplicate peer dependencies to reduce disk usage
dedupe-peer-dependents=true

# Prefer offline resolution when possible (faster repeat installs)
prefer-offline=true
