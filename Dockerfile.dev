# Development Dockerfile for TUPSAFE Next.js apps (employee/admin)
# Optimized for hot reload - does NOT build the app
# Usage: docker compose --env-file .env.local up -d

FROM node:22-alpine
WORKDIR /app

# Accept build argument for app name
ARG APP_NAME
ENV APP_NAME=${APP_NAME}

# CI=true prevents pnpm interactive prompts in Docker builds
ENV CI=true

# Install dependencies needed for node-gyp and native modules
RUN apk add --no-cache libc6-compat python3 make g++

# Enable corepack for pnpm version management
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy lockfile AND .npmrc first for pnpm fetch (Docker layer cache optimization)
# .npmrc must be present before fetch so pnpm uses correct node-linker/hoist settings
COPY pnpm-lock.yaml .npmrc ./
RUN pnpm fetch

# Copy package manifests
COPY package.json pnpm-workspace.yaml turbo.json ./
COPY apps/employee/package.json ./apps/employee/
COPY apps/admin/package.json ./apps/admin/
COPY packages/database/package.json ./packages/database/
COPY packages/auth/package.json ./packages/auth/
COPY packages/types/package.json ./packages/types/
COPY packages/shared-ui/package.json ./packages/shared-ui/

# Install ALL dependencies from store (populated by pnpm fetch)
# --offline uses only the local store, --frozen-lockfile ensures lockfile isn't modified
RUN pnpm install --frozen-lockfile --offline

# Copy source code (will be overridden by volume mounts in dev)
COPY . .

# Fix workspace symlinks: pnpm on Windows may create symlinks with Windows absolute paths
# (e.g., C:/Personal/TUPSAFE/packages/auth/) which don't resolve inside Linux containers.
# Replace all @tupsafe/* entries (symlinks or dereferenced copies) with correct Linux symlinks.
# Covers: root node_modules, app node_modules, AND package node_modules (cross-package deps).
RUN for tupsafe_dir in \
      /app/node_modules/@tupsafe \
      /app/apps/*/node_modules/@tupsafe \
      /app/packages/*/node_modules/@tupsafe; do \
      [ -d "$tupsafe_dir" ] || continue; \
      for entry in "$tupsafe_dir"/*; do \
        pkg=$(basename "$entry"); \
        target="/app/packages/$pkg"; \
        if [ -d "$target" ]; then \
          rm -rf "$entry"; \
          ln -s "$target" "$entry"; \
        fi; \
      done; \
    done

# Build shared packages (needed for Next.js to resolve @tupsafe/* imports)
# Each build is independent with || true so cross-package TS errors don't block Docker build.
# In dev mode, dist/ directories are volume-mounted from the host (pre-built locally).
RUN pnpm --filter @tupsafe/database build || true; \
    pnpm --filter @tupsafe/types build || true; \
    pnpm --filter @tupsafe/auth build || true; \
    pnpm --filter @tupsafe/shared-ui build || true

# Set development environment
ENV NODE_ENV=development
ENV PORT=3000

# Enable polling for file watching (required for Docker on Windows/macOS)
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

# Expose ports for both apps
EXPOSE 3000 3001

# Default command (overridden in docker-compose)
CMD pnpm run dev:${APP_NAME}
