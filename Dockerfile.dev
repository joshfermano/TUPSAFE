# Development Dockerfile for TUPSAFE Next.js apps (employee/admin)
# Optimized for hot reload - does NOT build the app
# Usage: docker compose -f docker-compose.yml -f docker-compose.dev.yml up

FROM node:22-alpine
WORKDIR /app

# Accept build argument for app name
ARG APP_NAME
ENV APP_NAME=${APP_NAME}

# Install dependencies needed for node-gyp and native modules
RUN apk add --no-cache libc6-compat python3 make g++

# Copy package files for dependency installation
COPY package*.json ./
COPY turbo.json ./
COPY apps/employee/package*.json ./apps/employee/
COPY apps/admin/package*.json ./apps/admin/
COPY packages/database/package*.json ./packages/database/
COPY packages/auth/package*.json ./packages/auth/
COPY packages/types/package*.json ./packages/types/
COPY packages/shared-ui/package*.json ./packages/shared-ui/

# Install ALL dependencies (including devDependencies for development)
RUN npm ci --ignore-scripts

# Copy source code (will be overridden by volume mounts in dev)
COPY . .

# Build shared packages (needed for Next.js to resolve @tupsafe/* imports)
RUN npm run build --workspace=@tupsafe/database && \
    npm run build --workspace=@tupsafe/types && \
    npm run build --workspace=@tupsafe/auth && \
    npm run build --workspace=@tupsafe/shared-ui

# Set development environment
ENV NODE_ENV=development
ENV PORT=3000

# Enable polling for file watching (required for Docker on Windows/macOS)
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

# Expose ports for both apps
EXPOSE 3000 3001

# Default command (overridden in docker-compose.dev.yml)
CMD npm run dev:${APP_NAME}
