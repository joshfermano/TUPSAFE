# ============================================
# TUPSAFE Development Environment
# ============================================
# Copy this file to .env.local:
#   copy .env.local.example .env.local   (Windows)
#   cp .env.local.example .env.local     (Mac/Linux)
#
# Then fill in the values below.
# .env.local is git-ignored and should NEVER be committed!
#
# Usage:
#   Development: docker compose --env-file .env.local up -d
#   Production:  docker compose -f docker-compose.prod.yml --env-file .env.local up -d

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from Supabase Dashboard > Settings > API
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Agent uses different variable names
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard
SUPABASE_PROJECT_REF=your-project-ref

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Transaction Pooler connection (Port 6543) - recommended for serverless
# Get from: Supabase Dashboard > Project Settings > Database > Connection string

DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# ============================================
# APP URLS CONFIGURATION
# ============================================
# External URLs for browser access
# Docker development uses localhost ports
# Production uses your domain (e.g., https://tupsafe.tup.edu.ph)

NEXT_PUBLIC_EMPLOYEE_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001

# ============================================
# EMAIL CONFIGURATION (SendGrid)
# ============================================
# SendGrid Web API for custom emails (OTP, credentials, status notifications)
# Supabase handles auth emails (signup confirmation, password reset)
#
# Get API key from: https://app.sendgrid.com/settings/api_keys
# Verify sender at: https://app.sendgrid.com/settings/sender_auth

SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM=tupsafe@tup.edu.ph
EMAIL_FROM_NAME=TUPSAFE

# Development: Mock emails (logs to console instead of sending)
# Set to 'false' to test real email sending
USE_MOCK_EMAILS=true

# ============================================
# LLM PROVIDER API KEYS (AI Agent)
# ============================================
# At least one provider is required for the AI Agent service

# OpenRouter (recommended - access to multiple models)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Google AI (Gemini) - https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIza-your-google-api-key

# Groq (fast inference) - https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key

# ============================================
# LLM CONFIGURATION (AI Agent)
# ============================================
# Default provider: openrouter, openai, groq, gemini

DEFAULT_LLM_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# ============================================
# REDIS CONFIGURATION
# ============================================
# Used for caching and session storage
# Docker Compose uses internal Redis container

# Development (no password, internal Docker network)
# Production should use a strong password
REDIS_PASSWORD=

# ============================================
# AI AGENT SECURITY CONFIGURATION
# ============================================
# IMPORTANT: Change these for production!

# API Secret Key - generate with: openssl rand -hex 32
API_SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# AI AGENT SERVER CONFIGURATION
# ============================================
LOG_LEVEL=info
DEBUG=true
ENVIRONMENT=development

# Agent behavior
AGENT_TIMEOUT_SECONDS=300
MAX_ITERATIONS=25
ENABLE_STREAMING=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# NODE ENVIRONMENT
# ============================================
# 'development' or 'production'
NODE_ENV=development

# ============================================
# DOCKER DEPLOYMENT NOTES
# ============================================
#
# 1. Internal Service Communication (use Docker service names):
#    - Redis: redis://redis:6379 (dev) or redis://:PASSWORD@redis:6379 (prod)
#    - AI Agent: http://ai-agent:8000
#
# 2. External Access (use localhost for development):
#    - Employee Portal: http://localhost:3000
#    - Admin Portal: http://localhost:3001
#    - AI Agent API: http://localhost:8000
#
# 3. Health Check Endpoints:
#    - Employee: http://localhost:3000/api/health
#    - Admin: http://localhost:3001/api/health
#    - AI Agent: http://localhost:8000/api/v1/health
#    - Redis: docker compose exec redis redis-cli ping
#
# 4. Development Commands:
#    npm run docker:start                 # Start all services
#    npm run docker:stop                  # Stop all services
#    npm run docker:logs                  # View logs
#    npm run docker:status                # Check status
#    npm run docker:rebuild               # Rebuild and restart
#
# 5. Production Commands:
#    npm run docker:prod                  # Start production
#    npm run docker:prod:stop             # Stop production
#
# 6. Security Best Practices:
#    - Never commit .env.local with real credentials
#    - Use strong passwords for production Redis
#    - Rotate API keys regularly
#    - Use Docker secrets for sensitive data in production
