# Copy to .env.local, fill in values. Never commit .env.local!
# Usage: docker compose --env-file .env.local up -d

# Supabase - Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard
SUPABASE_PROJECT_REF=your-project-ref

# Database - Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# App URLs
NEXT_PUBLIC_EMPLOYEE_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001

# Email (SendGrid) - Supabase handles auth emails separately
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM=tupsafe@tup.edu.ph
EMAIL_FROM_NAME=TUPSAFE
USE_MOCK_EMAILS=true

# LLM Provider API Keys (at least one required for AI Agent)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_API_KEY=AIza-your-google-api-key
GROQ_API_KEY=gsk_your-groq-api-key

# LLM Configuration - providers: openrouter, openai, groq, gemini
DEFAULT_LLM_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# Redis (no password for dev, use strong password in prod)
REDIS_PASSWORD=

# AI Agent Security - generate API_SECRET_KEY with: openssl rand -hex 32
API_SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Agent Server
LOG_LEVEL=info
DEBUG=true
ENVIRONMENT=development
AGENT_TIMEOUT_SECONDS=300
MAX_ITERATIONS=25
ENABLE_STREAMING=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Node
NODE_ENV=development
