# ============================================
# TUPSAFE EC2 Production Environment
# ============================================
# Copy to /opt/tupsafe/.env.prod on EC2 (chmod 600)

# AWS / ECR
AWS_ACCOUNT_ID=153028612339
AWS_REGION=ap-southeast-1
IMAGE_TAG=latest
ELASTIC_IP=18.142.250.161

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_PROJECT_REF=your-project-ref

# Database
DATABASE_URL=postgresql://postgres.your-ref:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# App URLs
NEXT_PUBLIC_EMPLOYEE_APP_URL=https://tupsafe.tech
NEXT_PUBLIC_ADMIN_APP_URL=http://18.142.250.161:9443

# Redis (generate password: openssl rand -hex 32)
REDIS_PASSWORD=change-me

# Email
SENDGRID_API_KEY=SG.your-key
EMAIL_FROM=noreply@tupsafe.tech
EMAIL_FROM_NAME=TUPSAFE

# LLM Keys
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENAI_API_KEY=sk-proj-your-key
GOOGLE_API_KEY=your-key
GROQ_API_KEY=gsk_your-key
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_MODEL=openai/gpt-oss-120b:nitro

# AI Agent Security (generate: openssl rand -hex 32)
API_SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Agent Config
LOG_LEVEL=warning
AGENT_TIMEOUT_SECONDS=300
MAX_ITERATIONS=25
ENABLE_STREAMING=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=2000
