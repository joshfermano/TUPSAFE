# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Portal Configuration (for session isolation)
# Must be 'admin' for admin portal to prevent cookie conflicts with employee portal
NEXT_PUBLIC_APP_PORTAL=admin

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/tupsafe

# Email Configuration
# Resend API key for sending emails (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Development: Mock emails instead of sending real ones (set to 'true' to enable)
# This is useful when you don't have a verified domain with Resend
USE_MOCK_EMAILS=false

# App Configuration
NEXT_PUBLIC_EMPLOYEE_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
