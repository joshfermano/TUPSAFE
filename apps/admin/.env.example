# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Portal Configuration (for session isolation)
# Must be 'admin' for admin portal to prevent cookie conflicts with employee portal
NEXT_PUBLIC_APP_PORTAL=admin

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/tupsafe
