# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Portal Configuration (for session isolation)
# Must be 'employee' for employee portal to prevent cookie conflicts with admin portal
NEXT_PUBLIC_APP_PORTAL=employee

# Database (Transaction Pooler - Port 6543)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tupsafe

# ============================================================
# Email Configuration
# ============================================================
# Custom emails (OTP, credentials, status notifications) are sent via SendGrid Web API
# Supabase Auth emails (signup confirmation, password reset) use Supabase SMTP settings

# SendGrid API Key (required for production emails)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Sender email address (must be verified in SendGrid)
# Verify at: https://app.sendgrid.com/settings/sender_auth
EMAIL_FROM=tupsafe@tup.edu.ph

# Sender display name (optional, defaults to 'TUPSAFE')
EMAIL_FROM_NAME=TUPSAFE

# Development: Mock emails instead of sending real ones
# When 'true' in development mode, emails are logged to console instead of sent
# Set to 'false' to test real email sending in development
USE_MOCK_EMAILS=true

# App Configuration
NEXT_PUBLIC_EMPLOYEE_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
