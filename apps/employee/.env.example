# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Portal Configuration (for session isolation)
# Must be 'employee' for employee portal to prevent cookie conflicts with admin portal
NEXT_PUBLIC_APP_PORTAL=employee

# Database (Transaction Pooler - Port 6543)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tupsafe

# Email Configuration
# Resend API key for sending emails (get from https://resend.com/api-keys)
# Note: SMTP is already configured in Supabase (smtp.resend.com)
# This API key is for direct email sending via Resend API
RESEND_API_KEY=re_your_resend_api_key_here

# App Configuration
NEXT_PUBLIC_EMPLOYEE_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
